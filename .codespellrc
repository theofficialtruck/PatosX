[codespell]
# "ore" is a legitimate in game item name (iron ore, gold ore), not a misspelling of "or"
# "panting" is the act of breathing rapidly (ducks pant to cool down), not "painting"
# "whos" / "whats" / "thats" / "poppin" are how people type in chat; DuckGPT matches them on purpose
# "nd" is the ordinal suffix in "2nd", which DuckGPT's math reads ("the 2nd root of ...")
ignore-words-list = ore,panting,whos,whats,thats,poppin,nd
